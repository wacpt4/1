<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DW德语学习助手</title>
<style>
/* ==========================================
   🎨 CSS 变量：定义浅色和深色主题
   ========================================== */
:root {
    --bg-gradient: linear-gradient(135deg, #f3f0ff, #e5dbff);
    --text-main: #3b286d;
    --text-sub: #705da4;
    --text-card-big: #4338ca;
    --text-card-small: #6b7280;
    --btn-bg: rgba(255, 255, 255, 0.6);
    --btn-color: #5f4bb6;
    --btn-active-bg: #5f4bb6;
    --btn-active-color: white;
    --card-bg: rgba(255, 255, 255, 0.7);
    --card-hover-bg: rgba(255, 255, 255, 0.95);
    --card-shadow: 0 4px 14px rgba(147, 130, 219, 0.15);
    --card-hover-shadow: 0 6px 20px rgba(147, 130, 219, 0.25);
    --card-border: rgba(255, 255, 255, 0.6);
    --card-playing-bg: #e0e7ff;
    --card-playing-border: #6366f1;
    --star-color: #d1d5db;
    --star-active-color: #fbbf24;

    /* 💬 聊天对话专属颜色 */
    --chat-left-bg: rgba(255, 255, 255, 0.95);
    --chat-right-bg: #e8e5ff;
    --chat-avatar-bg: #5f4bb6;

    /* 🎮 练习模式与拼词模式通用颜色 */
    --match-selected: #cbd5e1;
    --match-success-bg: #e2fbe8;
    --match-success-border: #22c55e;
    --match-success-text: #15803d;
    --match-error-bg: #fef2f2;
    --match-error-border: #ef4444;
    --match-error-text: #b91c1c;

    /* 🧩 拼词/提示框专属适配 */
    --builder-prompt-bg: rgba(255, 255, 255, 0.6);
    --builder-zone-bg: rgba(255, 255, 255, 0.3);
    --hint-bg: rgba(34, 197, 94, 0.15);
    --hint-border: #22c55e;
    --hint-text: #15803d;
}

[data-theme="dark"] {
    --bg-gradient: linear-gradient(135deg, #1e1b4b, #311042);
    --text-main: #f3f4f6;
    --text-sub: rgba(255, 255, 255, 0.6);
    --text-card-big: #a5b4fc;
    --text-card-small: #cbd5e1;
    --btn-bg: rgba(255, 255, 255, 0.1);
    --btn-color: #c7d2fe;
    --btn-active-bg: #6366f1;
    --btn-active-color: white;
    --card-bg: rgba(255, 255, 255, 0.08);
    --card-hover-bg: rgba(255, 255, 255, 0.15);
    --card-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    --card-hover-shadow: 0 6px 20px rgba(99, 102, 241, 0.2);
    --card-border: rgba(255, 255, 255, 0.1);
    --card-playing-bg: rgba(99, 102, 241, 0.35);
    --card-playing-border: #818cf8;
    --star-color: rgba(255, 255, 255, 0.2);
    --star-active-color: #fbbf24;

    /* 💬 聊天对话专属颜色 */
    --chat-left-bg: rgba(255, 255, 255, 0.08);
    --chat-right-bg: rgba(95, 75, 182, 0.3);
    --chat-avatar-bg: #818cf8;

    /* 🎮 连连看练习模式专属颜色 */
    --match-selected: rgba(99, 102, 241, 0.4);
    --match-success-bg: rgba(34, 197, 94, 0.2);
    --match-success-border: #22c55e;
    --match-success-text: #86efac;
    --match-error-bg: rgba(239, 68, 68, 0.2);
    --match-error-border: #f87171;
    --match-error-text: #fca5a5;

    /* 🧩 拼词/提示框深色模式优化 */
    --builder-prompt-bg: rgba(255, 255, 255, 0.08);
    --builder-zone-bg: rgba(0, 0, 0, 0.25);
    --hint-bg: rgba(34, 197, 94, 0.2);
    --hint-border: #4ade80;
    --hint-text: #86efac;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: var(--bg-gradient);
    color: var(--text-main);
    min-height: 100vh;
    transition: background 0.3s, color 0.3s;
    overflow-x: hidden;
}
.header { text-align: center; padding: 25px; position: relative; }
.header p { color: var(--text-sub); margin-top: 5px; }

.theme-toggle {
    position: absolute; right: 20px; top: 20px; padding: 10px 16px; font-size: 14px;
    background: var(--btn-bg); color: var(--btn-color); border-radius: 20px; box-shadow: var(--card-shadow);
}

.tabs { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; padding: 0 10px; }
button {
    border: none; padding: 12px 22px; border-radius: 12px; cursor: pointer; font-size: 15px;
    background: var(--btn-bg); color: var(--btn-color); transition: 0.2s; box-shadow: var(--card-shadow);
    -webkit-tap-highlight-color: transparent;
}
button:hover { background: var(--card-hover-bg); }
.tabs button.active { background: var(--btn-active-bg); color: var(--btn-active-color); font-weight: bold; }

.page { display: none; max-width: 1200px; margin: auto; padding: 20px; box-sizing: border-box; }
.page.show { display: block !important; }

/* 🖼️ 卡片图片样式 */
.card-img {
    max-width: 100%; max-height: 130px; object-fit: contain;
    border-radius: 10px; margin-bottom: 10px; display: block;
    margin-left: auto; margin-right: auto; pointer-events: none;
}

/* 🧱 基础网格布局 */
.grid-word { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 15px; }
.grid-word .big { font-size: 1.4rem; font-weight: bold; color: var(--text-card-big); }
.grid-word .small { font-size: 1rem; margin-top: 8px; color: var(--text-card-small); }

.grid-phrase { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 15px; }
.grid-phrase .big { font-size: 1.25rem; font-weight: bold; color: var(--text-card-big); }
.grid-phrase .small { font-size: 1.05rem; margin-top: 6px; color: var(--text-card-small); }

.grid-sentence { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 15px; }
.grid-sentence .card { text-align: left; padding: 20px; }
.grid-sentence .big { font-size: 1.2rem; font-weight: bold; line-height: 1.4; color: var(--text-card-big); }
.grid-sentence .small { font-size: 1.05rem; margin-top: 8px; color: var(--text-card-small); line-height: 1.4; }

.grid-long-sentence { display: grid; grid-template-columns: repeat(auto-fit, minmax(500px, 1fr)); gap: 20px; }
@media (max-width: 600px) { .grid-long-sentence { grid-template-columns: 1fr; } }
.grid-long-sentence .card { text-align: left; padding: 24px; display: flex; flex-direction: column; gap: 10px; }
.grid-long-sentence .big { font-size: 1.15rem; font-weight: bold; line-height: 1.5; color: var(--text-card-big); border-bottom: 1px dashed var(--card-border); padding-bottom: 8px; padding-right: 25px; }
.grid-long-sentence .small { font-size: 1.05rem; line-height: 1.6; color: var(--text-card-small); margin: 0; }
.grid-long-sentence .card-img { max-height: 180px; align-self: center; }

/* 🚨 对话布局 */
.grid-dialogue { display: flex; flex-direction: column; gap: 20px; width: 100%; padding: 10px; box-sizing: border-box; }
.dialogue-row { display: flex; width: 100%; box-sizing: border-box; margin-bottom: 5px; }
.dialogue-row.left { justify-content: flex-start; }
.dialogue-row.right { justify-content: flex-end; }
.dialogue-content { display: flex; gap: 14px; max-width: 75%; align-items: flex-start; }
.dialogue-row.left .dialogue-content { flex-direction: row; }
.dialogue-row.right .dialogue-content { flex-direction: row-reverse; }
.chat-avatar {
    width: 44px; height: 44px; border-radius: 50%; background: var(--chat-avatar-bg); color: white;
    display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.1rem; box-shadow: var(--card-shadow); flex-shrink: 0;          
}
.dialogue-content .card { display: block; width: auto; text-align: left; padding: 16px 22px; border-radius: 20px; box-sizing: border-box; }
.dialogue-row.left .card { background: var(--chat-left-bg); border-top-left-radius: 4px; }
.dialogue-row.right .card { background: var(--chat-right-bg); border-top-right-radius: 4px; }
.dialogue-content .card .big { font-size: 1.15rem; font-weight: bold; color: var(--text-main); line-height: 1.5; padding-right: 25px; text-align: left; }
.dialogue-content .card .small { font-size: 1rem; margin-top: 6px; color: var(--text-card-small); line-height: 1.45; text-align: left; }

/* 公共卡片样式 */
.card {
    position: relative; background: var(--card-bg); backdrop-filter: blur(10px);
    padding: 24px 18px 18px 18px; border-radius: 18px; text-align: center; cursor: pointer;
    transition: transform 0.2s, background 0.2s, box-shadow 0.2s, border-color 0.2s;
    box-shadow: var(--card-shadow); border: 1px solid var(--card-border); user-select: none;
    -webkit-tap-highlight-color: transparent;
}
.card:hover { transform: translateY(-3px); background: var(--card-hover-bg); box-shadow: var(--card-hover-shadow); }
.star-icon {
    position: absolute; top: 14px; right: 16px; font-size: 1.1rem; color: var(--star-color);
    cursor: pointer; transition: transform 0.1s, color 0.2s; user-select: none; z-index: 10;
}
.star-icon:hover { transform: scale(1.2); }
.star-icon.active { color: var(--star-active-color); filter: drop-shadow(0 0 2px rgba(251, 191, 36, 0.4)); }
.card.playing { background: var(--card-playing-bg) !important; border-color: var(--card-playing-border) !important; transform: scale(1.02) translateY(-1px); }

/* 🚀 左上角悬浮播放面板 */
.play-panel { position: fixed; left: 20px; top: 20px; z-index: 9999; display: flex; gap: 8px; flex-wrap: wrap; }
.autoplay-btn, .practice-mode-btn, .builder-mode-btn, .image-mode-btn { 
    font-size: 14px; padding: 10px 16px; border-radius: 20px; background: #6366f1; color: white;
    font-weight: bold; letter-spacing: 0.5px; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2); transition: 0.2s;
}
.autoplay-btn:hover, .practice-mode-btn:hover, .builder-mode-btn:hover, .image-mode-btn:hover { background: #4f46e5; transform: scale(1.05); }
.autoplay-btn.playing, .practice-mode-btn.active, .builder-mode-btn.active, .image-mode-btn.active { background: #ef4444; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2); }
.empty-tip { text-align: center; padding: 40px; color: var(--text-sub); font-style: italic; font-size: 1.1rem; }

/* 🎮 练习模式与互动系统 UI */
.practice-container {
    max-width: 800px; margin: 20px auto; padding: 24px; background: var(--card-bg);
    border: 1px solid var(--card-border); border-radius: 24px; box-shadow: var(--card-shadow); backdrop-filter: blur(10px);
}
.practice-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; padding: 0 5px; flex-wrap: wrap; gap: 10px;}
.practice-header h3 { margin: 0; color: var(--text-main); font-size: 1.2rem; }

/* 模块左上角子模式控制栏 */
.sub-controls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.sub-btn {
    font-size: 12px; padding: 6px 12px; border-radius: 12px; background: var(--btn-bg);
    color: var(--btn-color); border: 1px solid var(--card-border); cursor: pointer; transition: 0.2s; font-weight: bold;
}
.sub-btn.active { background: #6366f1; color: white; border-color: #6366f1; }

.page-controls { display: flex; align-items: center; gap: 8px; }
.nav-arrow {
    padding: 5px 12px; font-size: 14px; border-radius: 8px; background: var(--btn-bg);
    color: var(--btn-color); border: 1px solid var(--card-border); cursor: pointer; transition: 0.15s;
}
.nav-arrow:hover:not(:disabled) { transform: scale(1.1); background: var(--card-hover-bg); }
.nav-arrow:disabled { opacity: 0.3; cursor: not-allowed; }

.practice-board { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.practice-column { display: flex; flex-direction: column; gap: 14px; }
.practice-card {
    padding: 18px 14px; font-size: 1.05rem; font-weight: 500; border-radius: 16px;
    text-align: center; background: var(--card-bg); border: 2px solid var(--card-border);
    color: var(--text-main); box-shadow: var(--card-shadow); cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.15s;
    min-height: 36px; display: flex; align-items: center; justify-content: center; user-select: none;
}
.practice-card:hover { transform: translateY(-2px); background: var(--card-hover-bg); }
.practice-card.selected { background: var(--match-selected) !important; border-color: var(--btn-active-bg) !important; transform: scale(0.97); }
.practice-card.success {
    animation: successPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    background: var(--match-success-bg) !important; border-color: var(--match-success-border) !important;
    color: var(--match-success-text) !important; cursor: default; pointer-events: none;
}
.practice-card.error { animation: errorShake 0.4s ease-in-out; background: var(--match-error-bg) !important; border-color: var(--match-error-border) !important; color: var(--match-error-text) !important; }

/* 🔊 连连看静态/动态波形图案 */
.wave-container { display: flex; align-items: center; justify-content: center; gap: 5px; height: 26px; }
.wave-icon { font-size: 1.2rem; margin-right: 4px; }
.wave-bar { width: 4px; background-color: var(--btn-color); border-radius: 3px; height: 6px; transition: height 0.2s; }
.wave-bar.static:nth-child(1) { height: 8px; }
.wave-bar.static:nth-child(2) { height: 16px; }
.wave-bar.static:nth-child(3) { height: 22px; }
.wave-bar.static:nth-child(4) { height: 14px; }
.wave-bar.static:nth-child(5) { height: 20px; }
.wave-bar.static:nth-child(6) { height: 10px; }

.wave-container.playing .wave-bar { animation: audioDance 0.6s ease-in-out infinite alternate; }
.wave-container.playing .wave-bar:nth-child(1) { animation-delay: 0.1s; }
.wave-container.playing .wave-bar:nth-child(2) { animation-delay: 0.3s; }
.wave-container.playing .wave-bar:nth-child(3) { animation-delay: 0.15s; }
.wave-container.playing .wave-bar:nth-child(4) { animation-delay: 0.4s; }
.wave-container.playing .wave-bar:nth-child(5) { animation-delay: 0.25s; }
.wave-container.playing .wave-bar:nth-child(6) { animation-delay: 0.35s; }

@keyframes audioDance {
    0% { height: 4px; }
    100% { height: 24px; background-color: #6366f1; }
}

/* 🧩 拼词/拼单词 UI 样式 */
.builder-target-prompt {
    font-size: 1.25rem; font-weight: bold; color: var(--text-card-big); margin-bottom: 20px;
    text-align: center; line-height: 1.4; padding: 14px; background: var(--builder-prompt-bg);
    border: 1px solid var(--card-border); border-radius: 16px; display: flex; align-items: center; justify-content: center; gap: 10px;
}
.speaker-btn {
    background: var(--btn-bg); color: var(--btn-color); border: 1px solid var(--card-border);
    border-radius: 50%; width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 1.1rem; padding: 0; box-shadow: var(--card-shadow); transition: 0.15s;
}
.speaker-btn:hover { transform: scale(1.1); background: var(--card-hover-bg); }

.builder-answer-zone {
    min-height: 65px; background: var(--builder-zone-bg); border: 2px solid var(--card-border);
    border-radius: 16px; margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 8px;
    align-items: center; justify-content: center; padding: 12px; transition: border-color 0.3s, background 0.3s;
}
.builder-answer-zone.error { border-color: var(--match-error-border) !important; background: var(--match-error-bg) !important; animation: errorShake 0.4s ease-in-out; }
.builder-answer-zone.success { border-color: var(--match-success-border) !important; background: var(--match-success-bg) !important; }

.correct-answer-hint {
    margin-bottom: 15px; padding: 12px 18px; background: var(--hint-bg); border: 1px solid var(--hint-border);
    border-radius: 12px; color: var(--hint-text); font-weight: bold; font-size: 1.05rem; text-align: center; display: none; box-shadow: var(--card-shadow);
}
.correct-answer-hint.show { display: block; animation: fadeIn 0.3s ease-in-out; }

.builder-pool-zone { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; min-height: 80px; margin-bottom: 20px; }
.tile-btn {
    padding: 10px 18px; font-size: 1.1rem; font-weight: bold; border-radius: 14px;
    background: var(--card-bg); border: 2px solid var(--card-border); box-shadow: var(--card-shadow);
    color: var(--text-main); cursor: pointer; transition: transform 0.15s, background 0.2s; user-select: none;
}
.tile-btn:hover { transform: translateY(-2px); background: var(--card-hover-bg); }
.tile-btn.disabled { opacity: 0.2; pointer-events: none; transform: none; box-shadow: none; }
.builder-actions { display: flex; justify-content: center; gap: 15px; }
.btn-check { background: #22c55e; color: white; font-weight: bold; padding: 12px 30px; border-radius: 16px; font-size: 1.05rem; box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3); }
.btn-check:hover { background: #16a34a; }
.btn-clear { background: var(--btn-bg); color: var(--text-main); padding: 12px 20px; border-radius: 16px; border: 1px solid var(--card-border); }

/* ⌨️ 德语软键盘样式 */
.virtual-keyboard {
    display: flex; flex-direction: column; gap: 8px; align-items: center; margin-bottom: 20px; margin-top: 10px;
}
.keyboard-row { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; width: 100%; }
.key-btn {
    min-width: 36px; height: 42px; padding: 0 8px; font-size: 1rem; font-weight: bold; border-radius: 8px;
    background: var(--btn-bg); border: 1px solid var(--card-border); color: var(--text-main);
    box-shadow: var(--card-shadow); cursor: pointer; transition: 0.15s; display: flex; align-items: center; justify-content: center;
}
.key-btn:hover { background: var(--card-hover-bg); transform: translateY(-2px); }
.key-btn:active { transform: translateY(0); }
.key-btn.wide { min-width: 65px; }
.key-btn.space { min-width: 140px; }

/* 🖼️ 听音选图模式样式 */
.image-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 20px; }
.image-choice-card {
    background: var(--card-bg); border: 3px solid var(--card-border); border-radius: 18px;
    padding: 16px; display: flex; align-items: center; justify-content: center; cursor: pointer;
    box-shadow: var(--card-shadow); transition: transform 0.2s, border-color 0.2s; min-height: 140px;
}
.image-choice-card:hover { transform: translateY(-3px); background: var(--card-hover-bg); }
.image-choice-card img { max-width: 100%; max-height: 120px; object-fit: contain; pointer-events: none; }
.image-choice-card.success { animation: successPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; background: var(--match-success-bg) !important; border-color: var(--match-success-border) !important; }
.image-choice-card.error { animation: errorShake 0.4s ease-in-out; background: var(--match-error-bg) !important; border-color: var(--match-error-border) !important; }

/* 🌟 多邻国风格反馈与奖励动画 */
.score-board {
    display: flex; justify-content: space-between; align-items: center;
    background: rgba(99, 102, 241, 0.1); padding: 10px 18px; border-radius: 16px; margin-bottom: 15px; font-weight: bold; color: var(--text-main);
}
.streak-badge { color: #f59e0b; font-size: 1.1rem; }

/* 🎆 通关全屏视觉反馈 Overlay */
.celebration-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px);
    z-index: 100000; display: flex; flex-direction: column; align-items: center; justify-content: center;
    color: white; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
}
.celebration-overlay.show { opacity: 1; pointer-events: auto; }
.celebration-card {
    background: rgba(255, 255, 255, 0.1); border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 28px; padding: 40px 30px; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    transform: scale(0.7); transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    max-width: 90%; width: 400px;
}
.celebration-overlay.show .celebration-card { transform: scale(1); }
.celebration-title { font-size: 2.2rem; font-weight: 900; color: #fbbf24; text-shadow: 0 4px 12px rgba(251, 191, 36, 0.4); margin-bottom: 10px; }
.celebration-subtitle { font-size: 1.2rem; color: #e2e8f0; margin-bottom: 25px; }
.celebration-badge { font-size: 4rem; margin-bottom: 15px; animation: bounceIcon 1s infinite alternate; }
.celebration-btn {
    background: linear-gradient(135deg, #22c55e, #16a34a); color: white; font-weight: bold;
    font-size: 1.1rem; padding: 14px 36px; border-radius: 18px; border: none; cursor: pointer;
    box-shadow: 0 6px 20px rgba(34, 197, 94, 0.4); transition: transform 0.2s;
}
.celebration-btn:hover { transform: scale(1.05); }

@keyframes bounceIcon {
    0% { transform: translateY(0) scale(1); }
    100% { transform: translateY(-10px) scale(1.1); }
}

/* 粒子金币动画 */
.confetti {
    position: fixed; width: 10px; height: 10px; background-color: #fbbf24;
    border-radius: 50%; pointer-events: none; z-index: 999999;
    animation: particleFly 0.8s ease-out forwards;
}
@keyframes particleFly {
    0% { transform: translate(0, 0) scale(1); opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)) scale(0.2); opacity: 0; }
}

@keyframes successPop {
    0% { transform: scale(1); }
    50% { transform: scale(1.06); }
    100% { transform: scale(1); opacity: 0.5; }
}
@keyframes errorShake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-6px); }
