// 🔊 增强型多邻国 Web Audio 音效合成器
// ==========================================
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

function playSoundEffect(type) {
    if (audioCtx.state === 'suspended') { audioCtx.resume(); }
    const now = audioCtx.currentTime;

    if (type === 'success') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(523.25, now); // C5
        osc.frequency.exponentialRampToValueAtTime(880, now + 0.15); // A5
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
        osc.start(now);
        osc.stop(now + 0.3);
    } else if (type === 'error') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(180, now);
        osc.frequency.linearRampToValueAtTime(110, now + 0.2);
        gain.gain.setValueAtTime(0.4, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
        osc.start(now);
        osc.stop(now + 0.25);
    } else if (type === 'victory') {
        // 🔥 激烈的通关胜利音效（多音阶升调和弦）
        const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
        notes.forEach((freq, idx) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.type = 'triangle';
            const startTime = now + idx * 0.08;
            osc.frequency.setValueAtTime(freq, startTime);
            gain.gain.setValueAtTime(0.3, startTime);
            gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.4);
            osc.start(startTime);
            osc.stop(startTime + 0.4);
        });
    }
}

// 🎉 粒子金币飞溅奖励动画
function triggerConfetti(x, y) {
    const cx = x || window.innerWidth / 2;
    const cy = y || window.innerHeight / 2;
    for (let i = 0; i < 20; i++) {
        const particle = document.createElement('div');
        particle.className = 'confetti';
        document.body.appendChild(particle);
        
        const dx = (Math.random() - 0.5) * 260;
        const dy = (Math.random() - 0.5) * 260;
        
        particle.style.left = `${cx}px`;
        particle.style.top = `${cy}px`;
        particle.style.setProperty('--dx', `${dx}px`);
        particle.style.setProperty('--dy', `${dy}px`);
        
        const colors = ['#fbbf24', '#22c55e', '#6366f1', '#ec4899', '#3b82f6'];
        particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
        
        setTimeout(() => particle.remove(), 800);
    }
}

// 🎆 显示全屏大反馈通关弹窗
function showCelebrationModal(msg) {
    playSoundEffect('victory');
    triggerConfetti(window.innerWidth / 2, window.innerHeight / 2);
    const overlay = document.getElementById('celebrationOverlay');
    const msgEl = document.getElementById('celebrationMsg');
    if (msgEl && msg) msgEl.innerText = msg;
    if (overlay) overlay.classList.add('show');
}

function closeCelebration() {
    const overlay = document.getElementById('celebrationOverlay');
    if (overlay) overlay.classList.remove('show');
}

function updateScore(points) {
    if (points > 0) {
        userScore += points;
        currentStreak++;
        playSoundEffect('success');
    } else {
        currentStreak = 0;
        playSoundEffect('error');
    }
    const scoreText = document.getElementById('score-display');
    const streakText = document.getElementById('streak-display');
    if (scoreText) scoreText.innerText = userScore;
    if (streakText) streakText.innerText = currentStreak > 1 ? `🔥 ${currentStreak} 连胜!` : '';
}

function toggleTheme() {
    const currentTheme = document.body.getAttribute('data-theme');
    if (currentTheme === 'dark') document.body.removeAttribute('data-theme');
    else document.body.setAttribute('data-theme', 'dark');
}

function speak(text, callback, onStart) {
    let cleanedText = text;
    if (text.length === 1 && text === text.toUpperCase()) { cleanedText = text.toLowerCase(); }
    if (cleanedText === 'ä' || cleanedText === 'Ä') cleanedText = 'eh';
    if (cleanedText === 'ö' || cleanedText === 'Ö') cleanedText = 'öh';
    if (cleanedText === 'ü' || cleanedText === 'Ü') cleanedText = 'üh';
    if (cleanedText === 'ß' || cleanedText === 'ẞ') cleanedText = 'esszett';
    
    const u = new SpeechSynthesisUtterance(cleanedText);
    u.lang = "de-DE";
    if (onStart) u.onstart = () => onStart();
    if (callback) {
        u.onend = () => callback();
        u.onerror = () => callback();
    }
    speechSynthesis.cancel();
    speechSynthesis.speak(u);
}

function toggleStar(e, pageKey, itemIndex, starEl) {
    e.stopPropagation(); 
    const item = appData[pageKey].items[itemIndex];
    const uniqueId = `${pageKey}-${itemIndex}`;
    const existingIndex = starredItems.findIndex(x => x.id === uniqueId);
    
    if (existingIndex > -1) {
        starredItems.splice(existingIndex, 1);
        document.querySelectorAll(`.star-${uniqueId}`).forEach(el => el.classList.remove('active'));
    } else {
        starredItems.push({
            id: uniqueId, pageKey: pageKey,
            layout: appData[pageKey].layout, speakType: appData[pageKey].speakType,
            data: item
        });
        document.querySelectorAll(`.star-${uniqueId}`).forEach(el => el.classList.add('active'));
    }
    localStorage.setItem('german_helper_stars', JSON.stringify(starredItems));
    renderReviewPage();
}

function renderReviewPage() {
    const reviewGrid = document.getElementById('review-grid');
    if (!reviewGrid) return;
    reviewGrid.removeAttribute('class'); 
    reviewGrid.innerHTML = '';
    
    if (starredItems.length === 0) {
        reviewGrid.innerHTML = `<div class="empty-tip">⭐ 还没有标记重点。点击其他页面卡片上的星星，不熟的内容会同步到这里哦！</div>`;
        return;
    }
    
    reviewGrid.className = 'grid-sentence'; 
    starredItems.forEach((fav) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'grid-sentence'; 
        
        const isDialogue = fav.layout === 'dialogue';
        const imgUrl = isDialogue ? fav.data[3] : fav.data[2];
        const imgHtml = imgUrl ? `<img src="${imgUrl}" class="card-img" alt="illustration">` : '';

        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `
            <span class="star-icon active star-${fav.id}" onclick="toggleStar(event, '${fav.pageKey}', ${fav.id.split('-')[1]}, this)">★</span>
            ${imgHtml}
            <div class='big'>${fav.data[0]}</div>
            <div class='small'>${fav.data[1]}</div>
        `;
        const textToSpeak = fav.speakType === 'key' ? fav.data[0] : fav.data[1];
        card.onclick = () => { stopAutoplay(); speak(textToSpeak); };
        wrapper.appendChild(card);
        reviewGrid.appendChild(wrapper);
    });
}

function syncStarUIFromStorage() {
    starredItems.forEach(fav => {
        document.querySelectorAll(`.star-${fav.id}`).forEach(el => el.classList.add('active'));
    });
}

function startAutoplay() {
    const activePage = document.getElementById(`page-${currentActivePageId}`);
    const cards = activePage.querySelectorAll('.card');
    
    if (currentPlayIndex >= cards.length || cards.length === 0) {
        stopAutoplay();
        return;
    }

    cards.forEach(c => c.classList.remove('playing'));
    const currentCard = cards[currentPlayIndex];
    if (!currentCard) { stopAutoplay(); return; }
    
    currentCard.classList.add('playing');
    currentCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    let textToSpeak = "";
    if (currentActivePageId === 'review') {
        const fav = starredItems[currentPlayIndex];
        textToSpeak = fav ? (fav.speakType === 'key' ? fav.data[0] : fav.data[1]) : "";
    } else {
        const pageConfig = appData[currentActivePageId];
        const itemData = pageConfig.items[currentPlayIndex];
        textToSpeak = pageConfig.speakType === 'key' ? itemData[0] : itemData[1];
    }

    speak(textToSpeak, () => {
        if (!isAutoplayRunning) return;
        currentPlayIndex++;
        setTimeout(() => { if (isAutoplayRunning) startAutoplay(); }, 1400); 
    });
}

function stopAutoplay() {
    isAutoplayRunning = false;
    speechSynthesis.cancel();
    document.querySelectorAll('.card').forEach(c => c.classList.remove('playing'));
    const btn = document.getElementById('autoPlayBtn');
    btn.innerHTML = "▶";
    btn.classList.remove('playing');
}

function toggleAutoPlay() {
    if (isPracticeModeActive) quitPracticeMode();
    if (isBuilderModeActive) quitBuilderMode();
    if (isImageModeActive) quitImageMode();

    if (isAutoplayRunning) {
        stopAutoplay();
    } else {
        isAutoplayRunning = true;
        currentPlayIndex = 0;
        const btn = document.getElementById('autoPlayBtn');
        btn.innerHTML = "⏸";
        btn.classList.add('playing');
        startAutoplay();
    }
}

