// ==========================================
function togglePracticeMode() {
    if (isAutoplayRunning) stopAutoplay(); 
    if (isBuilderModeActive) quitBuilderMode();
    if (isImageModeActive) quitImageMode();

    const btn = document.getElementById('practiceBtn');
    if (isPracticeModeActive) {
        quitPracticeMode();
    } else {
        isPracticeModeActive = true;
        btn.innerHTML = "❌ 退出";
        btn.classList.add('active');
        initPracticeGame();
    }
}

function quitPracticeMode() {
    isPracticeModeActive = false;
    isAnimating = false;
    const btn = document.getElementById('practiceBtn');
    btn.innerHTML = "🎮 连连看";
    btn.classList.remove('active');
    clearPracticeView();
    switchPage(currentActivePageId);
}

function clearPracticeView() {
    const existBox = document.getElementById('practice-box');
    if (existBox) existBox.remove();
}

function setAudioMatchMode(enabled) {
    isAudioMatchMode = enabled;
    renderPracticeGroup();
}

function initPracticeGame() {
    clearPracticeView();
    let sourceItems = (currentActivePageId === 'review') ? starredItems.map(x => x.data) : appData[currentActivePageId].items;

    if (sourceItems.length === 0) {
        alert("当前页面没有可以练习的词汇哦！");
        quitPracticeMode();
        return;
    }

    practiceItemsAll = sourceItems.map((item, idx) => ({ id: idx, german: item[0], translation: item[1] }));
    practiceGroupIndex = 0;
    
    document.querySelectorAll('.page').forEach(p => { p.style.setProperty('display', 'none', 'important'); p.classList.remove('show'); });
    renderPracticeGroup();
}

function navigatePracticeGroup(step) {
    if (isAnimating) return;
    const totalGroups = Math.ceil(practiceItemsAll.length / 8);
    const newIndex = practiceGroupIndex + step;
    if (newIndex >= 0 && newIndex < totalGroups) {
        practiceGroupIndex = newIndex;
        renderPracticeGroup();
    }
}

function renderPracticeGroup() {
    const startIdx = practiceGroupIndex * 8;
    const currentGroup = practiceItemsAll.slice(startIdx, startIdx + 8);
    const totalGroups = Math.ceil(practiceItemsAll.length / 8);

    if (currentGroup.length === 0) {
        showCelebrationModal("太棒了！本页连连看项目全部完成！");
        quitPracticeMode();
        return;
    }

    clearPracticeView();

    const practiceBox = document.createElement('div');
    practiceBox.id = 'practice-box';
    practiceBox.className = 'practice-container';

    practiceBox.innerHTML = `
        <div class="score-board">
            <span>得分: <span id="score-display">${userScore}</span></span>
            <span class="streak-badge" id="streak-display">${currentStreak > 1 ? `🔥 ${currentStreak} 连胜!` : ''}</span>
        </div>
        <div class="practice-header">
            <div class="sub-controls">
                <button class="sub-btn ${!isAudioMatchMode ? 'active' : ''}" onclick="setAudioMatchMode(false)">标准</button>
                <button class="sub-btn ${isAudioMatchMode ? 'active' : ''}" onclick="setAudioMatchMode(true)">🔊 听音</button>
            </div>
            <h3>🎮 连连看 (${practiceGroupIndex + 1}/${totalGroups})</h3>
            <div class="page-controls">
                <button class="nav-arrow" ${practiceGroupIndex === 0 ? 'disabled' : ''} onclick="navigatePracticeGroup(-1)">◀</button>
                <button class="nav-arrow" ${practiceGroupIndex >= totalGroups - 1 ? 'disabled' : ''} onclick="navigatePracticeGroup(1)">▶</button>
            </div>
        </div>
        <div class="practice-board">
            <div class="practice-column" id="german-col"></div>
            <div class="practice-column" id="translation-col"></div>
        </div>
    `;

    document.getElementById('pagesContainer').appendChild(practiceBox);

    const germanCol = document.getElementById('german-col');
    const translationCol = document.getElementById('translation-col');
    const shuffledGerman = [...currentGroup].sort(() => Math.random() - 0.5);
    const shuffledTranslation = [...currentGroup].sort(() => Math.random() - 0.5);

    selectedGermanCard = null;
    selectedTranslationCard = null;
    isAnimating = false;

    shuffledGerman.forEach(item => {
        const card = document.createElement('div');
        card.className = 'practice-card';
        card.dataset.id = item.id;
        card.dataset.german = item.german;
        
        if (isAudioMatchMode) {
            card.innerHTML = `
                <div class="wave-container" id="wave-${item.id}">
                    <span class="wave-icon">🔊</span>
                    <div class="wave-bar static"></div>
                    <div class="wave-bar static"></div>
                    <div class="wave-bar static"></div>
                    <div class="wave-bar static"></div>
                    <div class="wave-bar static"></div>
                    <div class="wave-bar static"></div>
                </div>
            `;
        } else {
            card.innerText = item.german;
        }

        card.onclick = (e) => { if(!isAnimating) selectGermanCard(card, item.german, item.id, e); };
        germanCol.appendChild(card);
    });

    shuffledTranslation.forEach(item => {
        const card = document.createElement('div');
        card.className = 'practice-card';
        card.innerText = item.translation;
        card.dataset.id = item.id;
        card.onclick = (e) => { if(!isAnimating) selectTranslationCard(card, e); };
        translationCol.appendChild(card);
    });
}

function selectGermanCard(cardElement, text, id, event) {
    if (cardElement.classList.contains('success')) return;

    const waveContainer = document.getElementById(`wave-${id}`);
    speak(text, () => {
        if (waveContainer) waveContainer.classList.remove('playing');
    }, () => {
        if (waveContainer) waveContainer.classList.add('playing');
    });

    if (selectedGermanCard) { selectedGermanCard.classList.remove('selected'); }
    selectedGermanCard = cardElement;
    selectedGermanCard.classList.add('selected');
    checkMatch(event);
}

function selectTranslationCard(cardElement, event) {
    if (cardElement.classList.contains('success')) return;

    if (selectedTranslationCard) { selectedTranslationCard.classList.remove('selected'); }
    selectedTranslationCard = cardElement;
    selectedTranslationCard.classList.add('selected');
    checkMatch(event);
}

function checkMatch(event) {
    if (!selectedGermanCard || !selectedTranslationCard) return;

    const germanId = selectedGermanCard.dataset.id;
    const translationId = selectedTranslationCard.dataset.id;

    if (germanId === translationId) {
        const c1 = selectedGermanCard;
        const c2 = selectedTranslationCard;
        
        c1.classList.remove('selected');
        c2.classList.remove('selected');
        c1.classList.add('success');
        c2.classList.add('success');

        if (isAudioMatchMode) {
            c1.innerText = c1.dataset.german;
        }

        updateScore(10);
        if (event) triggerConfetti(event.clientX, event.clientY);

        selectedGermanCard = null;
        selectedTranslationCard = null;

        const remaining = document.querySelectorAll('.practice-card:not(.success)');
        if (remaining.length === 0) {
            isAnimating = true;
            setTimeout(() => {
                const totalGroups = Math.ceil(practiceItemsAll.length / 8);
                if (practiceGroupIndex + 1 >= totalGroups) {
                    showCelebrationModal("🎉 太棒了！您已成功打通本页所有连连看！");
                    quitPracticeMode();
                } else {
                    practiceGroupIndex++;
                    renderPracticeGroup();
                }
            }, 700);
        }
    } else {
        isAnimating = true;
        const c1 = selectedGermanCard;
        const c2 = selectedTranslationCard;
        
        c1.classList.remove('selected');
        c2.classList.remove('selected');
        c1.classList.add('error');
        c2.classList.add('error');

        updateScore(0);

        selectedGermanCard = null;
        selectedTranslationCard = null;

        setTimeout(() => {
            c1.classList.remove('error');
            c2.classList.remove('error');
            isAnimating = false;
        }, 400);
    }
}

