function toggleBuilderMode() {
    if (isAutoplayRunning) stopAutoplay();
    if (isPracticeModeActive) quitPracticeMode();
    if (isImageModeActive) quitImageMode();

    const btn = document.getElementById('builderBtn');
    if (isBuilderModeActive) {
        quitBuilderMode();
    } else {
        isBuilderModeActive = true;
        btn.innerHTML = "❌ 退出";
        btn.classList.add('active');
        initBuilderGame();
    }
}

function quitBuilderMode() {
    isBuilderModeActive = false;
    isAnimating = false;
    const btn = document.getElementById('builderBtn');
    btn.innerHTML = "🧩 拼词";
    btn.classList.remove('active');
    clearBuilderView();
    switchPage(currentActivePageId);
}

function clearBuilderView() {
    const existBox = document.getElementById('builder-box');
    if (existBox) existBox.remove();
}

function setBuilderDifficulty(diff) {
    builderDifficulty = diff;
    initBuilderGame();
}

function initBuilderGame() {
    clearBuilderView();
    let sourceItems = (currentActivePageId === 'review') ? starredItems.map(x => ({
        german: x.data[0], translation: x.data[1]
    })) : appData[currentActivePageId].items.map(x => ({
        german: x[0], translation: x[1]
    }));

    if (sourceItems.length === 0) {
        alert("当前页面没有可以练习的内容哦！");
        quitBuilderMode();
        return;
    }

    builderItemsAll = sourceItems;
    builderIndex = 0;

    document.querySelectorAll('.page').forEach(p => { p.style.setProperty('display', 'none', 'important'); p.classList.remove('show'); });
    renderBuilderQuestion();
}

function navigateBuilderQuestion(step) {
    if (isAnimating) return;
    const newIndex = builderIndex + step;
    if (newIndex >= 0 && newIndex < builderItemsAll.length) {
        builderIndex = newIndex;
        renderBuilderQuestion();
    }
}

function renderBuilderQuestion() {
    clearBuilderView();
    builderErrorCount = 0;

    if (builderIndex >= builderItemsAll.length) {
        showCelebrationModal("🎉 恭喜！您已完美通关本页拼词任务！");
        quitBuilderMode();
        return;
    }

    const currentItem = builderItemsAll[builderIndex];
    const germanText = currentItem.german.trim();

    if (builderDifficulty === 1) {
        builderExpectedTokens = germanText.split(/\s+/);
    } else {
        builderExpectedTokens = germanText.split('');
    }

    builderTokensPool = builderExpectedTokens.map((token, idx) => ({ id: idx, token: token }));
    builderTokensPool.sort(() => Math.random() - 0.5);
    builderSelectedTokens = [];

    const builderBox = document.createElement('div');
    builderBox.id = 'builder-box';
    builderBox.className = 'practice-container';

    const promptDisplay = currentItem.translation;

    builderBox.innerHTML = `
        <div class="score-board">
            <span>得分: <span id="score-display">${userScore}</span></span>
            <span class="streak-badge" id="streak-display">${currentStreak > 1 ? `🔥 ${currentStreak} 连胜!` : ''}</span>
        </div>
        <div class="practice-header">
            <div class="sub-controls">
                <button class="sub-btn ${builderDifficulty === 1 ? 'active' : ''}" onclick="setBuilderDifficulty(1)">1. 拼句</button>
                <button class="sub-btn ${builderDifficulty === 2 ? 'active' : ''}" onclick="setBuilderDifficulty(2)">2. 拼词</button>
                <button class="sub-btn ${builderDifficulty === 3 ? 'active' : ''}" onclick="setBuilderDifficulty(3)">3. 盲拼</button>
            </div>
            <h3>🧩 (${builderIndex + 1}/${builderItemsAll.length})</h3>
            <div class="page-controls">
                <button class="nav-arrow" ${builderIndex === 0 ? 'disabled' : ''} onclick="navigateBuilderQuestion(-1)">◀</button>
                <button class="nav-arrow" ${builderIndex >= builderItemsAll.length - 1 ? 'disabled' : ''} onclick="navigateBuilderQuestion(1)">▶</button>
            </div>
        </div>
        <div class="builder-target-prompt">
            <span>${promptDisplay}</span>
            <button class="speaker-btn" title="听读音" onclick="speakCurrentTarget()">🔊</button>
        </div>
        <div class="builder-answer-zone" id="builder-answer-zone"></div>
        <div class="correct-answer-hint" id="correct-hint">💡 正确答案：${germanText}</div>
        
        ${builderDifficulty === 3 ? renderGermanKeyboardHTML() : '<div class="builder-pool-zone" id="builder-pool-zone"></div>'}

        <div class="builder-actions">
            <button class="btn-clear" onclick="clearBuilderSelection()">🔄 重置</button>
            <button class="btn-check" onclick="checkBuilderAnswer(event)">✅ 检查答案</button>
        </div>
    `;

    document.getElementById('pagesContainer').appendChild(builderBox);

    if (builderDifficulty !== 3) {
        renderBuilderTiles();
    } else {
        renderKeyboardAnswerZone();
    }

    if (builderDifficulty === 3) { speakCurrentTarget(); }
}

// ⌨️ 生成包含德语特殊字符与逗号句号的德语虚拟键盘
function renderGermanKeyboardHTML() {
    return `
        <div class="virtual-keyboard">
            <div class="keyboard-row">
                ${['Q','W','E','R','T','Z','U','I','O','P','Ü'].map(k => `<button class="key-btn" onclick="pressVirtualKey('${k}')">${k}</button>`).join('')}
            </div>
            <div class="keyboard-row">
                ${['A','S','D','F','G','H','J','K','L','Ö','Ä'].map(k => `<button class="key-btn" onclick="pressVirtualKey('${k}')">${k}</button>`).join('')}
            </div>
            <div class="keyboard-row">
                ${['Y','X','C','V','B','N','M','ß',',','.'].map(k => `<button class="key-btn" onclick="pressVirtualKey('${k}')">${k}</button>`).join('')}
                <button class="key-btn wide" onclick="pressVirtualKey('BACK')">⌫</button>
            </div>
            <div class="keyboard-row">
                <button class="key-btn space" onclick="pressVirtualKey(' ')">Space</button>
            </div>
        </div>
    `;
}

function pressVirtualKey(key) {
    if (key === 'BACK') {
        builderSelectedTokens.pop();
    } else {
        builderSelectedTokens.push({ id: Date.now() + Math.random(), token: key });
    }
    renderKeyboardAnswerZone();
}

function renderKeyboardAnswerZone() {
    const answerZone = document.getElementById('builder-answer-zone');
    if (!answerZone) return;
    answerZone.innerHTML = '';

    builderSelectedTokens.forEach((item, index) => {
        const btn = document.createElement('button');
        btn.className = 'tile-btn';
        btn.innerText = item.token === ' ' ? '␣' : item.token;
        btn.onclick = () => {
            builderSelectedTokens.splice(index, 1);
            renderKeyboardAnswerZone();
        };
        answerZone.appendChild(btn);
    });
}

function speakCurrentTarget() {
    if (builderItemsAll[builderIndex]) { speak(builderItemsAll[builderIndex].german); }
}

function renderBuilderTiles() {
    const answerZone = document.getElementById('builder-answer-zone');
    const poolZone = document.getElementById('builder-pool-zone');
    if (!answerZone || !poolZone) return;

    answerZone.innerHTML = '';
    poolZone.innerHTML = '';

    builderSelectedTokens.forEach((item, index) => {
        const btn = document.createElement('button');
        btn.className = 'tile-btn';
        btn.innerText = item.token === ' ' ? '␣' : item.token;
        btn.onclick = () => {
            if (builderDifficulty === 1) speak(item.token);
            builderSelectedTokens.splice(index, 1);
            renderBuilderTiles();
        };
        answerZone.appendChild(btn);
    });

    builderTokensPool.forEach((item) => {
        const btn = document.createElement('button');
        btn.className = 'tile-btn';
        btn.innerText = item.token === ' ' ? '␣' : item.token;

        const isSelected = builderSelectedTokens.some(s => s.id === item.id);
        if (isSelected) {
            btn.classList.add('disabled');
        } else {
            btn.onclick = () => {
                if (builderDifficulty === 1) speak(item.token);
                builderSelectedTokens.push(item);
                renderBuilderTiles();
            };
        }
        poolZone.appendChild(btn);
    });
}

function clearBuilderSelection() {
    builderSelectedTokens = [];
    if (builderDifficulty === 3) {
        renderKeyboardAnswerZone();
    } else {
        renderBuilderTiles();
    }
}

// 字符串标准化：转小写 + 忽略常见标点符号
function normalizeString(str) {
    return str
        .toLowerCase()
        .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?"'“”—]/g, "") 
        .replace(/\s+/g, " ")                             
        .trim();
}

function checkBuilderAnswer(event) {
    if (isAnimating) return;

    const answerZone = document.getElementById('builder-answer-zone');
    const hint = document.getElementById('correct-hint');
    const currentItem = builderItemsAll[builderIndex];

    const rawUserAnswer = builderSelectedTokens.map(t => t.token).join(builderDifficulty === 1 ? ' ' : '');
    
    // 灵活处理：忽略标点符号和大小写
    const cleanUserAnswer = normalizeString(rawUserAnswer);
    const cleanCorrectAnswer = normalizeString(currentItem.german);

    if (cleanUserAnswer === cleanCorrectAnswer) {
        isAnimating = true;
        if (hint) hint.classList.remove('show');
        answerZone.classList.add('success');
        updateScore(15);
        if (event) triggerConfetti(event.clientX, event.clientY);

        speak(currentItem.german, () => {
            setTimeout(() => {
                if (builderIndex + 1 >= builderItemsAll.length) {
                    showCelebrationModal("🎉 完美通关！拼词训练圆满完成！");
                    quitBuilderMode();
                } else {
                    builderIndex++;
                    isAnimating = false;
                    renderBuilderQuestion();
                }
            }, 600);
        });
    } else {
        builderErrorCount++;
        isAnimating = true;
        answerZone.classList.add('error');
        updateScore(0);

        // 错满三次才显示答案提示框
        if (builderErrorCount >= 3 && hint) { 
            hint.classList.add('show'); 
        }

        setTimeout(() => {
            answerZone.classList.remove('error');
            isAnimating = false;
        }, 500);
    }
}

