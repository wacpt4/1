    isImageModeActive = false;
    isAnimating = false;
    const btn = document.getElementById('imageBtn');
    btn.innerHTML = "🖼️ 选图";
    btn.classList.remove('active');
    clearImageView();
    switchPage(currentActivePageId);
}

function clearImageView() {
    const existBox = document.getElementById('image-box');
    if (existBox) existBox.remove();
}

function initImageGame() {
    clearImageView();
    let rawList = [];

    if (currentActivePageId === 'review') {
        starredItems.forEach(x => {
            const img = (x.layout === 'dialogue') ? x.data[3] : x.data[2];
            if (img) rawList.push({ german: x.data[0], translation: x.data[1], imgUrl: img });
        });
    } else {
        const page = appData[currentActivePageId];
        page.items.forEach(item => {
            const img = (page.layout === 'dialogue') ? item[3] : item[2];
            if (img) rawList.push({ german: item[0], translation: item[1], imgUrl: img });
        });
    }

    if (rawList.length < 2) {
        alert("当前分组带图片的卡片不足 2 张，无法生成选图测验！");
        quitImageMode();
        return;
    }

    imageModeItemsAll = rawList.sort(() => Math.random() - 0.5);
    imageModeIndex = 0;

    document.querySelectorAll('.page').forEach(p => { p.style.setProperty('display', 'none', 'important'); p.classList.remove('show'); });
    renderImageQuestion();
}

function navigateImageQuestion(step) {
    if (isAnimating) return;
    const newIndex = imageModeIndex + step;
    if (newIndex >= 0 && newIndex < imageModeItemsAll.length) {
        imageModeIndex = newIndex;
        renderImageQuestion();
    }
}

function renderImageQuestion() {
    clearImageView();

    if (imageModeIndex >= imageModeItemsAll.length) {
        showCelebrationModal("🎉 恭喜！你已完成本组听音选图测试！");
        quitImageMode();
        return;
    }

    const currentCorrect = imageModeItemsAll[imageModeIndex];
    let localDistractors = imageModeItemsAll.filter(item => item.german !== currentCorrect.german).sort(() => Math.random() - 0.5);
    let options = [currentCorrect, ...localDistractors.slice(0, 3)].sort(() => Math.random() - 0.5);

    const imageBox = document.createElement('div');
    imageBox.id = 'image-box';
    imageBox.className = 'practice-container';

    imageBox.innerHTML = `
        <div class="score-board">
            <span>得分: <span id="score-display">${userScore}</span></span>
            <span class="streak-badge" id="streak-display">${currentStreak > 1 ? `🔥 ${currentStreak} 连胜!` : ''}</span>
        </div>
        <div class="practice-header">
            <h3>👂 听音选图 (${imageModeIndex + 1}/${imageModeItemsAll.length})</h3>
            <div class="page-controls">
                <button class="nav-arrow" ${imageModeIndex === 0 ? 'disabled' : ''} onclick="navigateImageQuestion(-1)">◀</button>
                <button class="nav-arrow" ${imageModeIndex >= imageModeItemsAll.length - 1 ? 'disabled' : ''} onclick="navigateImageQuestion(1)">▶</button>
            </div>
        </div>
        <div class="builder-target-prompt">
            <button class="speaker-btn" title="播放读音" onclick="speakImageTarget()">🔊</button>
            <span id="image-german-reveal" style="margin-left:8px;">请听发音选图</span>
        </div>
        <div class="image-grid" id="image-grid"></div>
    `;

    document.getElementById('pagesContainer').appendChild(imageBox);

    const grid = document.getElementById('image-grid');
    options.forEach(opt => {
        const card = document.createElement('div');
        card.className = 'image-choice-card';
        card.innerHTML = `<img src="${opt.imgUrl}" alt="choice">`;
        card.onclick = (e) => { if(!isAnimating) checkImageChoice(card, opt.german, currentCorrect.german, e); };
        grid.appendChild(card);
    });

    setTimeout(() => speakImageTarget(), 300);
}

function speakImageTarget() {
    if (imageModeItemsAll[imageModeIndex]) { speak(imageModeItemsAll[imageModeIndex].german); }
}

function checkImageChoice(cardElement, chosenGerman, correctGerman, event) {
    const revealSpan = document.getElementById('image-german-reveal');

    if (chosenGerman === correctGerman) {
        isAnimating = true;
        cardElement.classList.add('success');
        
        if (revealSpan) {
            revealSpan.innerHTML = `<b style="color:#22c55e;">${correctGerman}</b>`;
        }

        updateScore(10);
        if (event) triggerConfetti(event.clientX, event.clientY);

        setTimeout(() => {
            if (imageModeIndex + 1 >= imageModeItemsAll.length) {
                showCelebrationModal("🎉 恭喜！听音选图全部通关！");
                quitImageMode();
            } else {
                imageModeIndex++;
                isAnimating = false;
                renderImageQuestion();
            }
        }, 1500);
    } else {
        isAnimating = true;
        cardElement.classList.add('error');
        updateScore(0);

        setTimeout(() => {
            cardElement.classList.remove('error');
            isAnimating = false;
        }, 500);
    }
}

// ==========================================
// 初始化 DOM 渲染与页面切换逻辑
// ==========================================
const tabsContainer = document.getElementById('tabsContainer');
const pagesContainer = document.getElementById('pagesContainer');

const reviewBtn = document.createElement('button');
reviewBtn.id = 'btn-review'; reviewBtn.innerHTML = "⭐ 重点"; reviewBtn.className = "active";
reviewBtn.onclick = () => switchPage('review');
tabsContainer.appendChild(reviewBtn);

const reviewPageDiv = document.createElement('div');
reviewPageDiv.id = 'page-review'; reviewPageDiv.className = 'page show';
const reviewGridDiv = document.createElement('div');
reviewGridDiv.id = 'review-grid';
reviewPageDiv.appendChild(reviewGridDiv);
pagesContainer.appendChild(reviewPageDiv);

Object.keys(appData).forEach((key) => {
    const pageConfig = appData[key];
    const btn = document.createElement('button');
    btn.id = `btn-${key}`; btn.innerHTML = pageConfig.title;
    btn.onclick = () => switchPage(key);
    tabsContainer.appendChild(btn);

    const pageDiv = document.createElement('div');
    pageDiv.id = `page-${key}`; pageDiv.className = 'page';
    
    const gridDiv = document.createElement('div');
    const layoutStyle = pageConfig.layout || 'word';
    gridDiv.className = `grid-${layoutStyle}`;

    pageConfig.items.forEach((item, itemIndex) => {
        if (layoutStyle === 'dialogue') {
            const direction = item[2] || 'left'; 
            const imgUrl = item[3] || '';
            const imgHtml = imgUrl ? `<img src="${imgUrl}" class="card-img" alt="illustration">` : '';
            const avatarTxt = direction === 'left' ? '😼' : '🐶';
            
            const row = document.createElement('div');
            row.className = `dialogue-row ${direction}`;
            row.innerHTML = `
                <div class="dialogue-content">
                    <div class="chat-avatar">${avatarTxt}</div>
                    <div class="card">
                        <span class="star-icon star-${key}-${itemIndex}" onclick="toggleStar(event, '${key}', ${itemIndex}, this)">★</span>
                        ${imgHtml}
                        <div class='big'>${item[0]}</div>
                        <div class='small'>${item[1]}</div>
                    </div>
                </div>
            `;
            const textToSpeak = pageConfig.speakType === 'key' ? item[0] : item[1];
            row.querySelector('.card').onclick = () => { stopAutoplay(); speak(textToSpeak); };
            gridDiv.appendChild(row);
        } else {
            const imgUrl = item[2] || '';
            const imgHtml = imgUrl ? `<img src="${imgUrl}" class="card-img" alt="illustration">` : '';

            const card = document.createElement('div');
            card.className = 'card';
            card.innerHTML = `
                <span class="star-icon star-${key}-${itemIndex}" onclick="toggleStar(event, '${key}', ${itemIndex}, this)">★</span>
                ${imgHtml}
                <div class='big'>${item[0]}</div>
                <div class='small'>${item[1]}</div>
            `;
            const textToSpeak = pageConfig.speakType === 'key' ? item[0] : item[1];
            card.onclick = () => { stopAutoplay(); speak(textToSpeak); };
            gridDiv.appendChild(card);
        }
    });
    pageDiv.appendChild(gridDiv);
    pagesContainer.appendChild(pageDiv);
});

renderReviewPage();
syncStarUIFromStorage();

function switchPage(pageId) {
    stopAutoplay();
    currentActivePageId = pageId;

    document.querySelectorAll('.tabs button').forEach(b => b.classList.remove('active'));
    const targetBtn = document.getElementById(`btn-${pageId}`);
    if (targetBtn) targetBtn.classList.add('active');

    document.querySelectorAll('.page').forEach(p => { p.style.removeProperty('display'); p.classList.remove('show'); });

    if (isPracticeModeActive) {
        document.querySelectorAll('.page').forEach(p => p.style.setProperty('display', 'none', 'important'));
        initPracticeGame();
    } else if (isBuilderModeActive) {
        document.querySelectorAll('.page').forEach(p => p.style.setProperty('display', 'none', 'important'));
        initBuilderGame();
    } else if (isImageModeActive) {
        document.querySelectorAll('.page').forEach(p => p.style.setProperty('display', 'none', 'important'));
        initImageGame();
    } else {
        const targetPage = document.getElementById(`page-${pageId}`);
        if (targetPage) targetPage.classList.add('show');
    }
}
</script>

